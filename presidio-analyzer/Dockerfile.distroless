# Distroless variant of presidio-analyzer: no shell, package manager, pip or uv in the final image.
# Differences from ./Dockerfile:
#   - No shell, so entrypoint.sh is not used; PORT and WORKERS have no effect.
#     Gunicorn is invoked directly: configure it with GUNICORN_CMD_ARGS.
#   - Python 3.12 (the version Azure Linux distroless ships) and UID 65532.
FROM ghcr.io/astral-sh/uv:0.11.15@sha256:e590846f4776907b254ac0f44b5b380347af5d90d668138ca7938d1b0c2f98d3 AS uv

FROM mcr.microsoft.com/azurelinux/base/python:3.12@sha256:9343005b72a7cc34847dcb8d09bb8a0c145311eff88c151c60d9c4904edaf6e9 AS builder
ARG NLP_CONF_FILE=presidio_analyzer/conf/default.yaml
ARG ANALYZER_CONF_FILE=presidio_analyzer/conf/default_analyzer.yaml
COPY --from=uv /uv /usr/local/bin/uv
ENV UV_PROJECT_ENVIRONMENT=/opt/venv UV_PYTHON_DOWNLOADS=never VIRTUAL_ENV=/opt/venv PATH=/opt/venv/bin:$PATH
WORKDIR /app
COPY pyproject.toml uv.lock ./
RUN uv sync --locked --no-cache --no-default-groups --extra server --no-install-project
COPY install_nlp_models.py ./
COPY ${NLP_CONF_FILE} /app/${NLP_CONF_FILE}
COPY ${ANALYZER_CONF_FILE} /app/${ANALYZER_CONF_FILE}
# spaCy shells out to pip to download models; pip (and setuptools, which spaCy pulls in)
# are only needed for this step and are removed afterwards.
RUN uv pip install pip \
    && python install_nlp_models.py --conf_file ${NLP_CONF_FILE} --analyzer_conf_file ${ANALYZER_CONF_FILE} \
    && uv pip uninstall pip setuptools

FROM mcr.microsoft.com/azurelinux/distroless/python:3.12-nonroot@sha256:f5b31eb11254a444ba92837d788c349344cde899110f629100f8ca1efd49ade3
ARG NLP_CONF_FILE=presidio_analyzer/conf/default.yaml
ARG ANALYZER_CONF_FILE=presidio_analyzer/conf/default_analyzer.yaml
ARG RECOGNIZER_REGISTRY_CONF_FILE=presidio_analyzer/conf/default_recognizers.yaml
ENV NLP_CONF_FILE=${NLP_CONF_FILE} \
    ANALYZER_CONF_FILE=${ANALYZER_CONF_FILE} \
    RECOGNIZER_REGISTRY_CONF_FILE=${RECOGNIZER_REGISTRY_CONF_FILE} \
    PYTHONDONTWRITEBYTECODE=1 \
    GUNICORN_CMD_ARGS="--workers=1 --bind=0.0.0.0:3000"
COPY --from=builder /opt/venv/lib/python3.12/site-packages /usr/lib/python3.12/site-packages
WORKDIR /app
COPY . /app/
USER 65532
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=3s --start-period=90s --retries=5 \
    CMD ["/usr/bin/python3", "-c", "import urllib.request as u; u.build_opener(u.ProxyHandler({})).open('http://localhost:3000/health', timeout=2)"]
ENTRYPOINT ["/usr/bin/python3", "-m", "gunicorn", "app:create_app()"]
